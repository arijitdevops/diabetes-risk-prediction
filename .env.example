# Copy to .env and adjust. Every variable below has a working default,
# so the project runs unconfigured: the dataset ships in data/raw/.

# Directory that holds diabetes_risk_prediction_dataset.csv
DATA_DIR=data/raw

# Where the fitted sklearn pipeline is written / read from
MODEL_PATH=models/model.joblib

# Flask environment: development enables the debug reloader
FLASK_ENV=development

# Session signing key for the Flask app. Generate a real one for any
# deployment:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Seed used for splitting, cross-validation and every estimator
RANDOM_SEED=42
